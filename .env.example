# ==============================================================================
# DOMAIN HUNTER - Environment Configuration Template
# ==============================================================================

# --- AI Providers ---
GEMINI_API_KEY="your_gemini_api_key"
NVIDIA_API_KEY="your_nvidia_nim_api_key"
XKIRO_API_KEY="your_xkiro_api_key"
OPENROUTER_API_KEY="" # Optional fallback

# --- Domain Marketplace & Registrars ---
GODADDY_API_KEY="your_godaddy_reseller_key"
GODADDY_API_SECRET="your_godaddy_reseller_secret"
# ATOM_API_KEY is used exclusively for marketplace & premium aftermarket domain availability (Stage 6)
ATOM_API_KEY="your_atom_token"

# --- Atom Trademark Search API (Phase 1: Brand & Trademark Collision Detection) ---
# NOTE: ATOM_TRADEMARK_API_KEY is kept strictly separate from the marketplace ATOM_API_KEY above.
# This ensures explicit isolation in case Atom provisions dedicated API keys or scopes for trademark searches.
# The real key will be added manually by the project owner; if empty/missing, the engine degrades gracefully to NOT_CHECKED.
ATOM_TRADEMARK_API_KEY=""
# Configurable base URL for Atom trademark searches, defaulting to the placeholder below:
ATOM_TRADEMARK_API_URL="https://api.atom.com/v1/trademarks/search"

# --- Cloud Persistence (Supabase PostgreSQL) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"

# --- Autonomous Scheduler ---
DAILY_HUNT_ENABLED="true"
DAILY_HUNT_HOUR="3"
DAILY_HUNT_MINUTE="0"
DAILY_HUNT_TIMEZONE="Africa/Cairo"


# --- Atom Domain Appraisal API (external market validation, Stage 9) ---
# Optional. Pipeline works without these. Never commit real credentials.
ATOM_ENABLED="true"
ATOM_API_TOKEN=""
ATOM_USER_ID=""
# Legacy alias: if ATOM_API_TOKEN is empty, ATOM_API_KEY is used for appraisal token
# ATOM_API_KEY is already defined above for marketplace checks
ATOM_MAX_APPRAISALS_PER_RUN="25"
ATOM_CACHE_TTL_HOURS="24"
ATOM_RANK_WEIGHT="0.12"
ATOM_CACHE_PATH=""


# --- Multi-Model Domain Quality Evaluation ---
MULTI_MODEL_EVALUATION_ENABLED="true"
MULTI_MODEL_STAGE1_POOL="50"
MULTI_MODEL_ARBITER_POOL="20"
MULTI_MODEL_JUDGE_BATCH_SIZE="5"
MULTI_MODEL_CALL_BUDGET="120"
MULTI_MODEL_TIMEOUT_SECONDS="25"
MULTI_MODEL_MAX_RETRIES="1"
MULTI_MODEL_DISAGREEMENT_THRESHOLD="22"
MULTI_MODEL_DISAGREEMENT_PENALTY="0.35"
MULTI_MODEL_MISSING_JUDGE_PENALTY="6"
MULTI_MODEL_MIN_CONFIDENCE="55"
MULTI_MODEL_ARBITER_REVIEW_MIN_SCORE="60"
MULTI_MODEL_EXPLORATION_RATIO="0.10"
MULTI_MODEL_UNANCHORED_CEILING="64"
MULTI_MODEL_WEAK_CEILING="72"
MULTI_MODEL_UNANCHORED_COMMERCIAL_CEILING="58"
MULTI_MODEL_WEAK_COMMERCIAL_CEILING="68"
MULTI_MODEL_FINAL_QUALITY_FLOOR="68"
MULTI_MODEL_FINAL_BRAND_FLOOR="60"
MULTI_MODEL_FINAL_COMMERCIAL_FLOOR="58"
MULTI_MODEL_FINAL_LINGUISTIC_FLOOR="60"
MULTI_MODEL_RED_TEAM_LOW_SCORE="55"
MULTI_MODEL_RED_TEAM_PENALTY="0.20"
# Optional explicit role overrides; values must already exist in router task profiles.
# MULTI_MODEL_LINGUISTIC_PROVIDER="xkiro"
# MULTI_MODEL_LINGUISTIC_MODEL="qwen/qwen3.8-max:free"
# MULTI_MODEL_BRAND_PROVIDER="nvidia"
# MULTI_MODEL_BRAND_MODEL="glm-5.3-flash"
# MULTI_MODEL_COMMERCIAL_PROVIDER="nvidia"
# MULTI_MODEL_COMMERCIAL_MODEL="deepseek-ai/deepseek-v4.1-flash"
# MULTI_MODEL_RED_TEAM_PROVIDER="nvidia"
# MULTI_MODEL_RED_TEAM_MODEL="deepseek-ai/deepseek-v4.1-flash"
# MULTI_MODEL_ARBITER_PROVIDER="xkiro"
# MULTI_MODEL_ARBITER_MODEL="qwen/qwen3.8-max:free"
