# ==============================================================================
# DOMAIN HUNTER - Environment Configuration Template
# ==============================================================================

# --- AI Providers ---
GEMINI_API_KEY="your_gemini_api_key"
NVIDIA_API_KEY="your_nvidia_nim_api_key"
XKIRO_API_KEY="your_xkiro_api_key"
OPENROUTER_API_KEY="" # Optional fallback

# --- Domain Marketplace & Registrars ---
GODADDY_API_KEY="your_godaddy_reseller_key"
GODADDY_API_SECRET="your_godaddy_reseller_secret"
# ATOM_API_KEY is used exclusively for marketplace & premium aftermarket domain availability (Stage 6)
ATOM_API_KEY="your_atom_token"

# --- Atom Trademark Search API (Phase 1: Brand & Trademark Collision Detection) ---
# NOTE: ATOM_TRADEMARK_API_KEY is kept strictly separate from the marketplace ATOM_API_KEY above.
# This ensures explicit isolation in case Atom provisions dedicated API keys or scopes for trademark searches.
# The real key will be added manually by the project owner; if empty/missing, the engine degrades gracefully to NOT_CHECKED.
ATOM_TRADEMARK_API_KEY=""
# Configurable base URL for Atom trademark searches, defaulting to the placeholder below:
ATOM_TRADEMARK_API_URL="https://api.atom.com/v1/trademarks/search"

# --- Cloud Persistence (Supabase PostgreSQL) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"

# --- Autonomous Scheduler ---
DAILY_HUNT_ENABLED="true"
DAILY_HUNT_HOUR="3"
DAILY_HUNT_MINUTE="0"
DAILY_HUNT_TIMEZONE="Africa/Cairo"
